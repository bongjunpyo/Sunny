# frontend/.env.local 로 복사해서 쓴다. .env.local 은 커밋되지 않는다.
# 키 이름의 원본은 ../backend/README.md (초안 — 이재원이 확정)
#
# NEXT_PUBLIC_ 이 붙은 값은 브라우저에 그대로 보인다.
# 아래 서버 전용 키에는 절대 NEXT_PUBLIC_ 을 붙이지 않는다.

# 화면 데이터 모드 — mock | api  (비워 두면 mock)
NEXT_PUBLIC_API_MODE=

# ── 서버 전용 (frontend/app/api · frontend/lib/server 에서만 읽는다) ──

# Sanity CMS
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_READ_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 기상청 생활기상지수 — 공공데이터포털 인증키
KMA_SERVICE_KEY=

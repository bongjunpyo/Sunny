# frontend/.env.local 로 복사해서 쓴다. .env.local 은 커밋되지 않는다.
# 변수 이름의 원본은 ../backend/README.md
#
# NEXT_PUBLIC_ 이 붙은 값은 브라우저에 그대로 보인다.
# 아래 서버 전용 키에는 절대 NEXT_PUBLIC_ 을 붙이지 않는다.

# 화면 데이터 모드 — mock | api  (비워 두면 mock)
NEXT_PUBLIC_API_MODE=

# Next 서버 전용 — API 원점만 적는다. /api 경로나 비밀값을 붙이지 않는다.
# 로컬: http://127.0.0.1:8000 / 배포: FastAPI Vercel 프로젝트의 HTTPS 원점
FASTAPI_URL=http://127.0.0.1:8000

# Sanity·Supabase·기상청 설정은 ../backend/.env.local로 옮긴다.

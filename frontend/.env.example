# frontend/.env.local 로 복사해서 쓴다. .env.local 은 커밋되지 않는다.
# 키 이름의 원본은 ../backend/README.md (초안 — 이재원이 확정)
#
# NEXT_PUBLIC_ 이 붙은 값은 브라우저에 그대로 보인다.
# 아래 서버 전용 키에는 절대 NEXT_PUBLIC_ 을 붙이지 않는다.

# 화면 데이터 모드 — mock | api  (비워 두면 mock)
NEXT_PUBLIC_API_MODE=

# ── 서버 전용 (frontend/app/api · frontend/lib/server 에서만 읽는다) ──

# Sanity CMS
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_READ_TOKEN=

# private R2 사진 — 개발 localhost에서만 허용, 운영은 계약/보관 정책 합의 전 강제 차단.
PHOTO_UPLOAD_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 기상청 생활기상지수 — 공공데이터포털 인증키
KMA_SERVICE_KEY=

# 인증 — 기본 비활성. backend/auth/prepare-local.mjs가 누락된 로컬 값만 준비한다.
AUTH_ENABLED=false
AUTH_DATABASE_URL=
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# 실제 팀 소유 인증 발신 도메인 검증 후 서버에서만 설정. 없으면 가입/재발송 503.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# 개발 서버 + loopback origin에서만 허용. 인증 메일은 비공개 로컬 파일로 저장한다.
AUTH_DEV_LOCAL_MAIL=false

# 서버 전용 Kakao OAuth. 키가 없으면 이메일 인증은 유지하고 카카오만 비활성화한다.
KAKAO_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
